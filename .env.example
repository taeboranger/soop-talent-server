# SoopTalent 서버 설정 예시
# 이 파일을 복사해 실제 값을 채운 뒤 환경변수로 주입하세요.
# 절대 실제 시크릿이 담긴 파일을 저장소에 커밋하지 마세요.

# ── 필수 ─────────────────────────────────────────────────────────────────
DATABASE_URL=sooptalent:sooptalent@tcp(localhost:3307)/soop-talent?parseTime=true&charset=utf8mb4&loc=Asia%2FSeoul

# ── 관리자 ───────────────────────────────────────────────────────────────
# 공식 SOOP OAuth로 로그인한 사용자의 SOOP ID가 이 목록에 있으면 관리자가 된다. 쉼표 구분.
# 운영 관리자: lightstone1
ADMIN_SOOP_IDS=lightstone1

# ── 서버 ─────────────────────────────────────────────────────────────────
LISTEN=:8080
# SOOP 로그인 콜백 주소를 만드는 데 쓴다. 외부에서 접근 가능한 주소여야 한다.
PUBLIC_URL=https://soop-talent.cagea1.com
# 첫 OAuth 로그인 뒤 안내 페이지의 스트리머 확장 설치 링크.
STREAMER_EXTENSION_INSTALL_URL=https://chromewebstore.google.com/detail/ockjgoalmoffhfphpdijdlkmcafkkgln
MIGRATIONS=./migrations
LOG_LEVEL=info

# ── SOOP OAuth 로그인 ─────────────────────────────────────────────────────
# SOOP 계정으로만 로그인한다. 사용자 정보는 SOOP ID와 닉네임만 저장한다.
# Redirect URI: {PUBLIC_URL}/api/oauth/soop/callback

# https://developers.sooplive.com/my/apps
# Redirect URL: {PUBLIC_URL}/api/oauth/soop/callback
# API 사용 범위: 방송 여부(validate_live_status), 방송국 정보(user_stationinfo),
# 채팅 메시지 조회 및 보내기(broad_access_chatinfo)
# 이 공급자로 로그인하면 토큰에서 SOOP user_id를 직접 확인하여 방송국을 자동 연결한다.
SOOP_CLIENT_ID=
SOOP_CLIENT_SECRET=
# openssl rand -base64 32 로 만든 값. OAuth 토큰을 MySQL에 AES-256-GCM 암호화한다.
SOOP_TOKEN_ENCRYPTION_KEY=
# openssl rand -base64 32 로 만든 별도 값. 같은 Pod의 Chat SDK 브리지만 내부 API를 호출하게 한다.
CHAT_BRIDGE_SECRET=
# 같은 Pod의 Chat SDK 브리지 주소. Docker/Kubernetes 기본값도 이 주소다.
CHAT_BRIDGE_URL=http://127.0.0.1:8098

# 확장(chromiumapp.org) 외에 허용할 리다이렉트 주소. 쉼표 구분.
# 확장 로그인에는 쓰지 않는다. 별도 EXTENSION_REDIRECT_ALLOWLIST를 사용한다.
OAUTH_REDIRECT_ALLOWLIST=

# 스트리머 확장 OAuth 로그인에 필수.
# Chrome의 확장 관리 화면에서 확인한 "확장 프로그램 ID"를 정확히 넣는다.
# 등록하지 않은 확장이 OAuth 로그인 콜백을 받지 못하게 막는다.
# 스토어 배포 스트리머 확장 ID: ockjgoalmoffhfphpdijdlkmcafkkgln
EXTENSION_REDIRECT_ALLOWLIST=https://ockjgoalmoffhfphpdijdlkmcafkkgln.chromiumapp.org/

# ── 개발용 ───────────────────────────────────────────────────────────────
# 승인 절차 없이 강제로 수집할 SOOP 아이디. 운영에서는 비워둘 것.
STREAMERS=
