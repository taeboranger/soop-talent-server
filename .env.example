# SoopTalent 서버 설정 예시
# 이 파일을 복사해 실제 값을 채운 뒤 환경변수로 주입하세요.
# 절대 실제 시크릿이 담긴 파일을 저장소에 커밋하지 마세요.

# ── 필수 ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://sooptalent:sooptalent@localhost:5433/sooptalent

# ── 관리자 ───────────────────────────────────────────────────────────────
# OAuth로 로그인한 사용자의 검증된 이메일이 이 목록에 있으면 관리자가 된다. 쉼표 구분.
ADMIN_EMAILS=admin@example.com

# ── 서버 ─────────────────────────────────────────────────────────────────
LISTEN=:8080
# 소셜 로그인 콜백 주소를 만드는 데 쓴다. 외부에서 접근 가능한 주소여야 한다.
PUBLIC_URL=https://soop-talent.cagea1.com
MIGRATIONS=./migrations
LOG_LEVEL=info

# ── 소셜 로그인 (선택) ───────────────────────────────────────────────────
# 설정하지 않은 제공자는 확장에 버튼이 표시되지 않는다.
# 각 콘솔에 아래 Redirect URI를 등록할 것:
#   {PUBLIC_URL}/api/oauth/google/callback
#   {PUBLIC_URL}/api/oauth/naver/callback
#   {PUBLIC_URL}/api/oauth/kakao/callback

# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# https://developers.naver.com/apps
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# https://developers.kakao.com/console/app
# 카카오는 [카카오 로그인 > 보안]에서 Client Secret을 발급하고 '사용함'으로 설정해야 한다.
# 이메일 수집은 [동의 항목]에서 별도로 활성화해야 한다.
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

# 확장(chromiumapp.org) 외에 허용할 리다이렉트 주소. 쉼표 구분.
# 비워두면 확장에서만 로그인할 수 있다.
OAUTH_REDIRECT_ALLOWLIST=

# ── 개발용 ───────────────────────────────────────────────────────────────
# 승인 절차 없이 강제로 수집할 SOOP 아이디. 운영에서는 비워둘 것.
STREAMERS=
